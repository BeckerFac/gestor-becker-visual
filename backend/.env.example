# ============================================
# GESTIA Backend - Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gestia

# JWT Authentication (REQUIRED - min 16 chars each)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AFIP Electronic Invoicing
AFIP_ENV=homologacion
AFIP_CUIT=20123456789
AFIP_CERT_PATH=./certs/test.pem
AFIP_KEY_PATH=./certs/test.key

# Email - Resend (preferred)
RESEND_API_KEY=
RESEND_FROM=GESTIA <noreply@gestia.com.ar>

# Email - SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gestia.com.ar

# Frontend URL (for email links, CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Trial Configuration
TRIAL_DAYS=15
GRACE_DAYS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REQUEST_BODY_LIMIT=2mb
FILE_UPLOAD_LIMIT=5mb

# Encryption at rest (RECOMMENDED for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# AI - SecretarIA (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# WhatsApp Integration (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Logging
LOG_LEVEL=info
